#   2. Settings → Access Tokens → New token → Role: read → Create
#   3. Paste the token below — real AI activates immediately
# HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2 — Plant.id (requires paid plan for server-side use)
#   Free tier only works from one browser domain — not suitable for backends
# PLANT_ID_API_KEY=your_plant_id_key_here
